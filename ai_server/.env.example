# 이 파일을 .env 로 복사해서 쓴다 (cp .env.example .env)

# 엔드포인트별 모드: echo(LLM 없이 고정 응답) | llm(Claude 호출)
# 배선 확인 단계에서는 둘 다 echo. 준비된 쪽부터 llm 으로 바꾼다.
EXTRACT_MODE=echo
REVIEW_MODE=echo

# llm 모드에서만 필요. 몸통(.env)에는 절대 두지 않는다 — 키는 이 서버에만.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=8192

# ── scope_ai (llm 모드) ──
# 작품별 누적 상태(ep_global·임베딩·ERS·검수 결과) 저장 위치. 비우면 ./Data/stories
SCOPE_DATA_ROOT=
# bge = BGE-M3 (운영) | hash = 설치 없이 도는 가짜 임베더 (배선 확인용)
EMBEDDING_MODE=bge
# 비우면 자동(cuda 있으면 cuda). 예: cpu
EMBEDDING_DEVICE=
# 신규 사건마다 검수에 넘길 관련 선행 사건 수
ERS_TOP_K=5
