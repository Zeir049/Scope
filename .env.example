# ── 이 파일을 .env 로 복사해서 사용 (copy .env.example .env) ──
# 키 이름은 app/core/config.py 의 Settings 와 1:1 (대소문자 무관). 여기 없는 키는 Settings 기본값.
# 비밀값(JWT_SECRET, REDIS_PASSWORD)은 자리표시자다 — 실제 값은 .env 에만 둔다(.env 는 커밋 금지).

# ── DB ──
# 기본 = docker-compose.yml 의 db 컨테이너(127.0.0.1:5433). `docker compose up -d db redis` 로 바로 뜬다.
# (선택) 호스트에 네이티브 PostgreSQL 을 쓰면 포트·DB 이름만 바꾼다. 예: localhost:5432
# 앱 런타임은 async 드라이버(asyncpg), Alembic·backup.bat 은 sync URL(psycopg2)을 쓴다.
DATABASE_URL=postgresql+asyncpg://glitch:glitch@localhost:5433/glitch_integrated
DATABASE_URL_SYNC=postgresql+psycopg2://glitch:glitch@localhost:5433/glitch_integrated

# ── 인증(JWT) ──
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 파이프라인 주입 모드: fake | local | remote | replay ──
# replay: 시연용. app/pipeline/replay_data/chapter_1~3.txt 를 1~3화로 올리면 미리 만든 AI 결과가 나온다
# fake: 고정 예시 결과(외부 의존 없음) | remote: AI 서버(ai_server/, 기본 http://127.0.0.1:8100)
PIPELINE_MODE=fake
# remote 모드일 때만 사용. 예: http://127.0.0.1:8100
PIPELINE_REMOTE_URL=
# replay 모드일 때만 사용. 추출·검수 단계마다 기다리는 시간(초)
REPLAY_DELAY_SECONDS=3

# ── 분석 작업 큐 (arq 고정. inline 은 테스트 전용) ──
# 워커: python -m arq app.workers.worker.WorkerSettings (start_integrated.bat 이 같이 띄움)
QUEUE_MODE=arq
# Redis 비밀번호 — 필수. docker-compose.yml 이 requirepass 로 쓰고(없으면 기동 거부),
# REDIS_URL 에도 같은 값을 넣는다. 호스트는 127.0.0.1 (compose 가 IPv4 루프백에만 연다 — localhost=::1 이면 멈춤).
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# arq 작업 1건 상한(초). 파이프라인 HTTP 타임아웃(remote 300초)보다 넉넉하게
JOB_TIMEOUT_SECONDS=900
# 진행 중(extracting/reviewing) 회차가 이 시간(분) 넘게 그대로면 워커가 죽은 것으로 보고,
# 새 분석 요청이 오면 failed("시간 초과로 중단된 작업")로 기록한 뒤 받아준다.
# 실제 기준은 max(ANALYSIS_STALE_MINUTES, JOB_TIMEOUT_SECONDS/60 + 5) — 기본값이면 20분.
ANALYSIS_STALE_MINUTES=20

# ── CORS — 프론트를 다른 오리진에서 띄울 때만(쉼표 구분). 같은 오리진(/) 서빙이면 불필요 ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── 앱 시작 시 데모 시드(cho@example.com / glitch123, 금도끼 은도끼 예시) 주입 여부 ──
SEED_ON_STARTUP=true

# ── 기능 플래그 (끄면 해당 API 자체가 사라짐) ──
ENABLE_SUBSCRIPTION=true
ENABLE_SHARING=true
ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true
ENABLE_SMOKE=false

# ── Firebase 구글 로그인 연동 (프론트의 로그인) ──
# FIREBASE_MODE: google(실검증) | fake(fake:<email> 토큰을 무검증 통과 — 로컬 데모 전용, 공개 URL 금지)
# 데모 로그인(?demo=1)을 쓰려면 fake 로 바꾼다.
ENABLE_FIREBASE_AUTH=true
FIREBASE_MODE=google
FIREBASE_PROJECT_ID=test-project-825b6

# ── 레이트리밋(분당, IP별) — 0이면 끔 ──
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=30

# ── 회차 업로드 ──
ALLOWED_CHAPTER_EXTS=txt,docx,md,pdf
# 파일 상한(바이트, 10MB) / 추출·입력 텍스트 상한(글자 수)
MAX_UPLOAD_BYTES=10485760
MAX_CHAPTER_CHARS=500000
# 프로젝트 썸네일 이미지 상한(바이트, 5MB). PNG·JPEG·GIF·WebP 만 받는다
MAX_THUMBNAIL_BYTES=5242880

# ── 교체 가능 인프라 ──
# EMAIL_MODE: console | smtp(추후)   STORAGE_MODE: local | s3(추후)   CHAT_MODE: fake | remote(추후)
EMAIL_MODE=console
STORAGE_MODE=local
# 썸네일/파일 저장 루트(local)
UPLOAD_DIR=uploads
CHAT_MODE=fake
# 재설정/공유 링크에 쓰는 외부 접근 URL (터널을 열면 그 주소로)
PUBLIC_BASE_URL=http://localhost:8000
RESET_TOKEN_EXPIRE_MINUTES=60
